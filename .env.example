# MapMory frontend — copy to .env.local (ignored by Git). Restart Vite after edits.
# See docs/environment-setup.md for the mock/live setup matrix.
# Variables starting with VITE_ are embedded in the browser bundle: NOT secrets.

# Browser basemap; optional (fallback: desaturated OpenStreetMap tiles).
VITE_GEOAPIFY_KEY=

# Leave blank for standalone mock/demo mode. Set to a running Go API URL
# (typically http://127.0.0.1:8080) only for the full Firebase + PostgreSQL flow.
VITE_API_URL=

# All four required together for REAL Firebase sign-in; keep API key empty for
# demo sign-in. These are public Firebase Web app identifiers, not credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional for local Firebase Auth emulator; do not set in deployed builds.
VITE_FIREBASE_AUTH_EMULATOR_URL=
