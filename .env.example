# Copy to .env.local (git-ignored) and fill in. Without a key the map falls
# back to grey OpenStreetMap tiles.
VITE_GEOAPIFY_KEY=

# Optional: the Go backend (mapmory-backend, `go run ./cmd/server`). When set,
# the endpoints listed in src/api/client.ts (LIVE) call it through the Vite
# dev proxy; everything else stays on the mock. Leave empty for mock only.
VITE_API_URL=http://localhost:8080

# Optional: Firebase sign-in. Ask Ki Chun for the web app config of the shared
# mapmory-development project (it is public config, not a secret, but keep it in
# .env.local). Leave the API key empty to keep the demo sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mapmory-development.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mapmory-development
VITE_FIREBASE_APP_ID=
