# Copy to .env.local (git-ignored) and fill in. Without a key the map falls
# back to grey OpenStreetMap tiles.
VITE_GEOAPIFY_KEY=

# Optional: the Go backend (mapmory-backend, `go run ./cmd/server`). When set,
# the endpoints listed in src/api/client.ts (LIVE) call it through the Vite
# dev proxy; everything else stays on the mock. Leave empty for mock only.
VITE_API_URL=http://localhost:8080
